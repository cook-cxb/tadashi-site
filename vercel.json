{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" }
    ] },
    { "source": "/vault.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(learning|cave).html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
